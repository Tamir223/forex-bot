# APFEE SaaS Environment Variables
# Copy to .env and fill in every value
# NEVER commit .env to GitHub

# TELEGRAM
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
APFEE_BOT_USERNAME=APFEESignalBot

# CLAUDE API
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=1024

# TWELVE DATA (free at twelvedata.com)
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# DATABASE (AWS RDS PostgreSQL)
# Format: postgresql://username:password@RDS_ENDPOINT:5432/postgres
DATABASE_URL=postgresql://apfee:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/postgres

# STRIPE
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ELITE=price_...

# EMAIL (Resend SMTP - free at resend.com)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
FROM_EMAIL=noreply@apfee.io

# APP
ONBOARDING_URL=https://apfee.io/setup

# RISK GATES
CONFIDENCE_THRESHOLD=6
MIN_CONFLUENCE=4
MAX_TRADES_TODAY=2
MAX_OPEN_TRADES=2
MAX_LIVE_EXPOSURE=1.0
MAX_SESSION_LOSSES=2
MAX_WEEKLY_LOSSES=4
SESSION_START_HOUR=7
SESSION_END_HOUR=21
